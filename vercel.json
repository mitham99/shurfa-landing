{
  "redirects": [
    {
      "source": "/oman-national-day.html",
      "destination": "/oman-national-day",
      "permanent": true
    },
    {
      "source": "/sohar-festival.html",
      "destination": "/sohar-festival",
      "permanent": true
    },
    {
